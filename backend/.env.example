# Database Configuration (PostgreSQL with fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multimodal_chat

# Google Gemini API Key (for Multimodal Vision, Text Generation & Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Search API Key (DuckDuckGo works out-of-the-box without keys)
SEARCH_API_KEY=optional_search_key

# App Environment
ENVIRONMENT=development
DEBUG=True
MAX_FILE_SIZE_MB=15
